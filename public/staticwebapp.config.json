{
  "routes": [
    {
      "route": "/",
      "rewrite": "/index.html"
    }
  ],
  "navigationFallback": {
    "rewrite": "/index.html",
    "exclude": ["/data/*", "*.{css,js,json,png,jpg,jpeg,gif,svg,ico}"]
  },
  "mimeTypes": {
    ".json": "application/json",
    ".html": "text/html"
  },
  "globalHeaders": {
    "content-security-policy": "default-src 'self' https://cdn.plot.ly; script-src 'self' 'unsafe-inline' 'unsafe-eval' https://cdn.plot.ly; style-src 'self' 'unsafe-inline';",
    "cache-control": "public, max-age=3600"
  }
}
